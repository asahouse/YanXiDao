{
  "name": "yanxidao-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build && npm run build:server",
    "build:web": "vue-tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "start:prod": "node dist-server/index.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && tsx desktop/launch-desktop.ts",
    "desktop:fast": "tsx desktop/launch-desktop.ts",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --config electron-builder.json --win",
    "test:unit": "vitest run tests/unit",
    "test:e2e:web": "playwright test tests/e2e/web.spec.ts",
    "test:e2e:electron": "playwright test tests/e2e/electron.spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@yanxidao/shared": "git+https://github.com/asahouse/YanXiDao-Shared.git#v1.0.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-vue-next": "^1.0.0",
    "msedge-tts": "^2.1.1",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.5.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.11"
  }
}
