# ==========================================================
# 研习岛 (YanXiDao) 服务端环境变量配置示例
# 复制为 .env 后按需修改；未配置 DB_TYPE/DB_HOST 时默认使用内置 SQLite（兼容 Windows 安装版）
# ==========================================================

# 1. 数据库模式（mysql 或 sqlite；网页端/管理后台部署建议设置为 mysql）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=yanxidao
DB_AUTO_CREATE=true

# 2. 安全密钥（生产环境请务必设置为 32 位以上随机字符串）
YANXIDAO_USER_SECRET=replace_with_random_64_hex_chars_for_user_tokens
YANXIDAO_ADMIN_SECRET=replace_with_random_64_hex_chars_for_admin_tokens

# 3. 允许跨域的前端域名（逗号分隔；本地 localhost / Electron app:// 默认放行）
YANXIDAO_CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# 4. 是否允许远程同步访问内网 IP（生产环境建议保持 false 防止 SSRF）
YANXIDAO_ALLOW_PRIVATE_SYNC=false
